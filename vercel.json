{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.go" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/home", "destination": "/public/home.html" },
    { "source": "/register", "destination": "/public/register.html" },
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}